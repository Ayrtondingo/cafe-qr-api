# Copiar a .env para desarrollo local. Nunca subir el .env real.

NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# PostgreSQL (servicio `postgres` de docker-compose.yml)
DATABASE_URL=postgresql://cafe:cafe-dev@localhost:5432/cafe_qr?schema=public

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Proxies delante de la API (IP real del cliente): 1 = Nginx del frontend; 2 = + proxy HTTPS.
TRUST_PROXY_HOPS=1

# Base sombra (descartable) para `prisma migrate dev` y `npm run db:check-drift`.
# Vive en el contenedor postgres-test; se crea sola con `npm run db:up`.
SHADOW_DATABASE_URL=postgresql://cafe:cafe-test@localhost:5433/cafe_qr_shadow?schema=public
